# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=medium
EXTRACT_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=20
# live    = call the Claude API (needs ANTHROPIC_API_KEY)
# replay  = bundled samples only: saved results of the real run in examples/output/
# offline = bundled samples only: hand-written answer key, Claude is not called
EXTRACTOR_MODE=live
